# Supabase credentials.
# Copy this file to ".env" and fill in your project's values for local dev.
# In production, set the same two variables in Vercel:
#   Project Settings -> Environment Variables.
#
# The anon key is public by design — all access is gated by Row Level
# Security (see supabase/schema.sql). Never put the service_role key here.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
